rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Email verification is required to actually use the app (see
    // client/src/app/core/services/auth.service.ts) - enforced here too so
    // an unverified account can't read exam content or write results even
    // by calling Firestore directly, bypassing the UI gate.
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Teachers have the exact same permissions as admins throughout this app.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'teacher'];
    }

    function isStudent() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Profile documents (name, email, role, section), keyed by Firebase Auth
    // uid. Read/create intentionally don't require isVerified(): a account
    // needs to read/create its own profile before it has verified anything.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Public registration always creates a student profile for the signed-in uid.
      // Admin/teacher accounts are granted by an existing admin via an update, never self-assigned.
      allow create: if isOwner(uid) && request.resource.data.role == 'student';
      // Admins/teachers can change anything, including role, on any account.
      // Owners can update their own profile but never change their own role.
      allow update: if isAdmin() ||
        (isOwner(uid) && request.resource.data.role == resource.data.role);
      // Admins/teachers can remove a user's profile, cutting off their app access.
      // Note: this only deletes the Firestore profile, not the underlying Firebase Auth
      // account (that requires the Admin SDK, which this no-backend app doesn't have).
      allow delete: if isAdmin();
    }

    // Subject/chapter/topic catalog that questions and exams are organized under.
    match /subjects/{id} {
      allow read: if isVerified();
      allow write: if isAdmin();
    }
    match /chapters/{id} {
      allow read: if isVerified();
      allow write: if isAdmin();
    }
    match /topics/{id} {
      allow read: if isVerified();
      allow write: if isAdmin();
    }

    // Question bank. Any verified user can read (needed to render exam
    // content client-side); only admins can write. Note: this means the
    // MCQ answer key is technically visible to any signed-in student who
    // inspects network traffic — accepted trade-off of the no-backend setup.
    match /questions/{id} {
      allow read: if isVerified();
      allow write: if isAdmin();
    }

    // Exam definitions (title, section, subject, duration, question ids,
    // full-subject vs chapter-wise mode).
    match /exams/{id} {
      allow read: if isVerified();
      allow write: if isAdmin();
    }

    // Exam submissions. Students can create their own and read only their
    // own; admins can read/update (grade) any of them.
    match /results/{id} {
      allow read: if isAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
      allow create: if isVerified() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.studentEmail == request.auth.token.email;
      allow update: if isAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
      allow delete: if false;
    }
  }
}
